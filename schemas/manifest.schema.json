{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alethic:v1:manifest",
  "title": "Alethic manifest (.alethic/manifest.yaml)",
  "type": "object",
  "required": ["format_version", "project"],
  "properties": {
    "format_version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "budget": { "type": "integer", "minimum": 200, "maximum": 100000 },
        "lease_minutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "default_branch": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "extra_secret_patterns": {
          "description": "JavaScript regular expressions, matched against every string field.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "forbidden_globs": {
          "description": "Paths that records must never cite or fingerprint.",
          "type": "array",
          "items": { "$ref": "urn:alethic:v1:common#/$defs/repoPath" }
        }
      },
      "additionalProperties": false
    },
    "staleness": {
      "type": "object",
      "properties": {
        "changed_lines_threshold": {
          "description": "Changes to direct evidence of at most this many lines are labeled small, larger ones large. The label orders review; any change to direct evidence needs re-verification.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_glob_matches": { "type": "integer", "minimum": 1 },
        "max_fingerprints_per_record": { "type": "integer", "minimum": 0 },
        "max_receipt_files": {
          "description": "Most files `alethic receipt run` digests before and after a command. Beyond it, coverage is recorded as partial.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "ci_provenance": {
          "description": "Trusted source that may grant ci-verified. 'none' means ci-verified is always rejected.",
          "enum": ["none", "github-attestation"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
